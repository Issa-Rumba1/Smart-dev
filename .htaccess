# SMART DEV - Apache Configuration
# Security, routing, and performance settings

Options -Indexes
ServerSignature Off

# ── PHP Error Reporting (production: set to 0) ──
# php_flag  display_errors    Off
# php_value error_reporting   0

# ── Rewrite Engine (must be declared before any RewriteRules) ────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Protect sensitive directories from direct access
    RewriteRule ^config/.*$   - [F,L]
    RewriteRule ^includes/.*$ - [F,L]
    RewriteRule ^logs/.*$     - [F,L]
    RewriteRule ^database/.*$ - [F,L]

    # Block PHP execution inside uploads
    RewriteRule ^uploads/.*\.(php|php3|php4|php5|phtml|shtml)$ - [F,L]
</IfModule>

# ── Security Headers ─────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self)"
</IfModule>

# ── Block direct access to sensitive file types ──────────────
<FilesMatch "\.(sql|log|ini|env|sh|bak)$">
    <IfModule mod_authz_core.c>
        # Apache 2.4+
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        # Apache 2.2 fallback
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# ── Compression ──────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>

# ── Browser Caching ──────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg             "access plus 3 months"
    ExpiresByType image/png              "access plus 3 months"
    ExpiresByType image/webp             "access plus 3 months"
    ExpiresByType image/svg+xml          "access plus 3 months"
</IfModule>
